{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Legend",
  "version": "0.4.0",
  "identifier": "dev.kb.claudelegend",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Claude Legend",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Claude Code avec conversations synchronisées entre PC",
    "category": "DeveloperTool",
    "createUpdaterArtifacts": true
  },
  "mainBinaryName": "claude-legend",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzODM0RTREMkY3RDBCNTkKUldSWkMzMHZUVTZEby9QRUhEWmx0RGt2WUVBbkVOdlpiQWZpVDRsMEJIeW1uelJIVkVocVowVUoK",
      "endpoints": [
        "https://github.com/K-Bastin/claude-legend/releases/latest/download/latest.json"
      ]
    }
  }
}
