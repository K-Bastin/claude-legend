{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Legend",
  "version": "0.6.1",
  "identifier": "dev.kb.claudelegend",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Claude Legend",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost https://api.github.com",
        "object-src": "'none'",
        "base-uri": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost https://api.github.com ws://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Claude Code avec conversations synchronisées entre PC",
    "category": "DeveloperTool",
    "createUpdaterArtifacts": true
  },
  "mainBinaryName": "claude-legend",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzODM0RTREMkY3RDBCNTkKUldSWkMzMHZUVTZEby9QRUhEWmx0RGt2WUVBbkVOdlpiQWZpVDRsMEJIeW1uelJIVkVocVowVUoK",
      "endpoints": [
        "https://github.com/K-Bastin/claude-legend/releases/latest/download/latest.json"
      ]
    }
  }
}
